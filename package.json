{
  "name": "tracker-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Job de indexacao incremental de trackers + API de consulta",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node --env-file-if-exists=.env src/index.js sync",
    "enrich": "node --env-file-if-exists=.env src/index.js enrich",
    "stats": "node --env-file-if-exists=.env src/index.js stats",
    "serve": "node --env-file-if-exists=.env src/index.js serve",
    "query": "node --env-file-if-exists=.env src/index.js query",
    "keygen": "node src/index.js keygen",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/etag": "^6.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.2.0"
  }
}
