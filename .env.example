DB_FILE=./data/catalog.db

HTTP_TIMEOUT_MS=20000
HTTP_RETRIES=3

SYNC_MAX_PAGES_PER_TERM=100
SYNC_MAX_PAGES_PER_RUN=400

API_PORT=3000
API_HOST=0.0.0.0


# Chave gratuita em themoviedb.org -> Settings -> API. Sem ela, o enrich e pulado.
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR
TMDB_RPS=8
TMDB_STALE_DAYS=30
# Abaixo disso a nota nao e divulgada nem ordena: pouca votacao e ruido.
TMDB_MIN_VOTES=150
