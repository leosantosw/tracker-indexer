# Every variable is optional. See docs/configuration.md.

# Lets the panel store tokens and keys, encrypted. Generate one with: npm run keygen
SECRETS_KEY=

# Can also be set from the panel.
# ADMIN_TOKEN=
# API_TOKEN=
# TMDB_API_KEY=
# TMDB_LANGUAGE=pt-BR
# DEBRID_PROVIDER=torbox
# TORBOX_API_KEY=

# Server.
# DB_FILE=./data/catalog.db
# API_PORT=3000
# API_HOST=0.0.0.0
# LOG_LEVEL=info
